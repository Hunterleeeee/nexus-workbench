# OpenAI or any OpenAI-compatible endpoint.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional explicit HTTP/SOCKS proxy for the LLM request.
# LLM_PROXY=http://127.0.0.1:7890

# Feishu bot credentials. The public callback must have at least one of
# VERIFY_TOKEN or ENCRYPT_KEY configured; otherwise Workbench rejects events.
# WORKBENCH_FEISHU_APP_ID=cli_xxx
# WORKBENCH_FEISHU_APP_SECRET=your_app_secret
# WORKBENCH_FEISHU_VERIFY_TOKEN=your_verify_token
# WORKBENCH_FEISHU_ENCRYPT_KEY=your_encrypt_key

# Optional aliases supported by the backend:
# OPENAI_API_KEY=your_api_key_here

# Optional safe cloud-development workspaces. Only explicit absolute paths are
# accepted; use JSON or comma-separated alias=/absolute/path pairs.
# WORKBENCH_CLOUD_WORKSPACES={"workbench":"/srv/workbench"}
# WORKBENCH_CLOUD_COMMAND_TIMEOUT_SECONDS=120

# Optional ActivityWatch API used for weekly aggregated efficiency observations.
# Workbench never starts ActivityWatch and only stores event counts/durations.
# WORKBENCH_ACTIVITYWATCH_URL=https://activitywatch.example.com
# WORKBENCH_ACTIVITYWATCH_BUCKET_ID=aw-watcher-window

# Token for the public POST /api/git/inventory-push endpoint. This path is the
# only write API exposed without nginx Basic Auth, so the token must be long
# and random. Unset means the endpoint returns 503.
# WORKBENCH_GIT_PUSH_TOKEN=

# Obsidian vault to index read-only. Defaults to knowledge-base/obsidian.
# WORKBENCH_OBSIDIAN_VAULT_DIR=/absolute/path/to/vault

# Optional MinerU document parser. When the binary is on PATH, PDFs and images
# go through MinerU first (far better on Chinese layout, scans, formulas and
# merged tables) and fall back to MarkItDown / the built-in parsers on failure.
# WORKBENCH_MINERU_CMD=mineru
# WORKBENCH_MINERU_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# 应用层访问令牌（纵深防御，默认关闭）
#
# 不设置时行为与之前完全一致：所有保护都来自 nginx 的 auth_basic。
# 设置之后，除 /api/health、/feishu/、/static/、/api/git/inventory-push、
# /api/sub2api/sync-raw 之外的请求必须带 X-Workbench-Token 头或
# workbench_token Cookie，nginx 配置万一改错也不会让 API 直接裸奔。
# 开启前请先确认浏览器端会带上该 Cookie，否则会把自己挡在门外。
# WORKBENCH_API_TOKEN=

# 日志级别（DEBUG / INFO / WARNING / ERROR），默认 INFO；journalctl -u workbench -f 查看。
# WORKBENCH_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# LLM 调用超时（连接和读取分开，避免死掉的 Provider 占满两分钟才切 fallback）
# WORKBENCH_LLM_CONNECT_TIMEOUT_SECONDS=10
# WORKBENCH_LLM_READ_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Agent 运行参数
# 子 Agent 并发数（默认 3，上限 8）。调高会加快多目标调度，但更容易触发 429。
# WORKBENCH_AGENT_CHILD_CONCURRENCY=3
# 单个子 Agent 的 ReAct 工具轮次上限（默认 4，上限 8）。
# WORKBENCH_AGENT_MAX_TOOL_ROUNDS=4
# 同一轮内并行执行的工具调用数（默认 4，上限 8）。
# WORKBENCH_AGENT_MAX_PARALLEL_TOOL_CALLS=4
# 单个工具调用超时秒数（默认 60）。超时会作为结构化错误回喂给模型，让它换路子。
# WORKBENCH_AGENT_TOOL_TIMEOUT_SECONDS=60
# 单个子 Agent 总超时秒数（默认 420）。超时按失败隔离，其他子 Agent 结果照常返回。
# WORKBENCH_AGENT_CHILD_TIMEOUT_SECONDS=420
